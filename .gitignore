# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
bin/
dist/

# Dependency directories (remove the comment below to include it)
vendor/

# rapid (pgregory.net/rapid) per-run failure seeds — regenerated by tests,
# not regression-worthy on their own.
internal/tui/testdata/rapid/**/*.fail
internal/config/testdata/rapid/**/*.fail
